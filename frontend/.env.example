# Copy to .env.local and adjust per environment
# ==============================================
# REVIVE TESTNET (default) - deploy first: cd contracts && pnpm run deploy:revive
# ==============================================
NEXT_PUBLIC_CHAIN_ID=637173
NEXT_PUBLIC_REVIVE_RPC_URL=https://rpc-testnet.revive.global
NEXT_PUBLIC_CONTRACT_ADDRESS=<deploy-writes-this>

# ==============================================
# LOCAL (Hardhat) - for unit tests / optional local dev
# ==============================================
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ==============================================
# TESTNET (e.g. Sepolia) - deploy contract first
# ==============================================
# NEXT_PUBLIC_CHAIN_ID=11155111
# NEXT_PUBLIC_RPC_URL=https://rpc.sepolia.org
# NEXT_PUBLIC_CONTRACT_ADDRESS=<your-deployed-address>
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# ==============================================
# MAINNET - deploy contract first
# ==============================================
# NEXT_PUBLIC_CHAIN_ID=1
# NEXT_PUBLIC_RPC_URL=https://eth.llamarpc.com
# NEXT_PUBLIC_CONTRACT_ADDRESS=<your-deployed-address>
# NEXT_PUBLIC_MAINNET_RPC_URL=https://eth.llamarpc.com
